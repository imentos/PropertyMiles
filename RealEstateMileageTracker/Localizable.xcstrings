    "Automatically tracks your driving trips for real estate business mileage. Make sure to enable 'Always Allow' location permission for best results." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically tracks your driving trips for real estate business mileage. Make sure to enable 'Always Allow' location permission for best results."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动记录房地产相关的驾车行程。建议将定位权限设为“始终允许”，以获得最佳记录效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動記錄房地產相關的駕車行程。建議將定位權限設為「永遠允許」，以獲得最佳記錄效果。"
          }
        }
      }
    },
