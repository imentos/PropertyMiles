{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "-" : {

    },
    "\"Finally an app that works in the background. I don't have to remember to open it.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Finally an app that works in the background. I don't have to remember to open it.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“终于有一款能在后台记录的 App，不用再记得打开它了。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「終於有一款能在背景記錄的 App，不用再記得打開它了。」"
          }
        }
      }
    },
    "\"I tried spreadsheets. I tried notes apps. I always fell behind within two weeks.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"I tried spreadsheets. I tried notes apps. I always fell behind within two weeks.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“试过表格，也试过笔记 App，但不到两周就跟不上了。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「試過表格，也試過筆記 App，但不到兩週就跟不上了。」"
          }
        }
      }
    },
    "\"I used to guess at tax time. Now I just hand my accountant the CSV. Saved me hours of stress.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"I used to guess at tax time. Now I just hand my accountant the CSV. Saved me hours of stress.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“以前报税时只能靠猜。现在直接把 CSV 交给会计师，省下了好多时间。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「以前報稅時只能靠猜。現在直接把 CSV 交給會計師，省下了好多時間。」"
          }
        }
      }
    },
    "\"I've driven to the same property 12 times this year and logged maybe 3 of those trips.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"I've driven to the same property 12 times this year and logged maybe 3 of those trips.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“今年去同一处房子 12 次，可能只记了 3 次行程。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今年去同一處房子 12 次，可能只記了 3 次行程。」"
          }
        }
      }
    },
    "\"My accountant asked for driving records I couldn't find.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"My accountant asked for driving records I couldn't find.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“会计师问我要行车记录，我却找不到。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「會計師問我要行車紀錄，我卻找不到。」"
          }
        }
      }
    },
    "\"Paid for itself in the first week. I had no idea how many miles I was logging each month.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Paid for itself in the first week. I had no idea how many miles I was logging each month.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“第一周就觉得值了。我以前根本不知道自己每个月开了多少英里。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「第一週就覺得值了。我以前根本不知道自己每個月開了多少英里。」"
          }
        }
      }
    },
    "\"Tax season used to stress me out. I knew I was missing deductions but couldn't prove it.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Tax season used to stress me out. I knew I was missing deductions but couldn't prove it.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“报税季总让我紧张。我知道漏记了扣除项目，却拿不出记录。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「報稅季總讓我緊張。我知道漏記了扣除項目，卻拿不出紀錄。」"
          }
        }
      }
    },
